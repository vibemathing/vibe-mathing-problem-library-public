  "statement": {
    "language": "en",
    "text": "For every finite 3-connected graph G, does there exist an assignment of positive real lengths ℓ:E(G)→R_{>0} such that every ℓ-geodesic cycle is peripheral?",
    "version": 1
  },
  "title": "Geodesic cycles and Tutte's theorem",
