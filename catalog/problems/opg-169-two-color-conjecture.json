  "statement": {
    "language": "en",
    "text": "For every orientation G of a finite simple planar graph, can V(G) be partitioned into X₁ and X₂ so that each induced digraph G[Xᵢ] is acyclic?",
    "version": 1
  },
  "title": "The Two Color Conjecture for planar digraphs",
